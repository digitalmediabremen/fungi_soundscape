# GBIF download credentials — copy this file to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored; never commit real credentials.
# A free account: https://www.gbif.org/user/profile
#
# These are read by scripts/build-gbif-data.py (npm run build:gbif). They are
# NOT prefixed with VITE_, so Vite never exposes them to the browser bundle.

GBIF_USER=your_gbif_username      # your GBIF.org USERNAME, not your email
GBIF_PWD=your_gbif_password
GBIF_EMAIL=you@example.org

# Optional:
# GBIF_SCOPE=mo        # "mo" (Mushroom Observer dataset, default) or "fungi"
# GBIF_GRID=2          # coordinate decimals for grid-snapped sites (~1 km)
# GBIF_TIMEOUT=7200    # seconds to keep polling the async download
